---
import '../styles/global.css';
interface Props { title: string; description: string; page?: string }
const { title, description, page = 'overview' } = Astro.props;
const showHelpAction = page !== 'help';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, nosnippet, noimageindex" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF9F6" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'has-help-action': showHelpAction }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="brand" href="/" aria-label="Ukraine TPS Collective — home">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span></span>
        <span>Ukraine TPS <span class="brand-light">Collective</span></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={page === 'overview' ? 'page' : undefined}>Overview</a>
        <a href="/background/" aria-current={page === 'background' ? 'page' : undefined}>TPS background</a>
        <a href="/take-action/" aria-current={page === 'help' ? 'page' : undefined}>How to help</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer shell">
      <span>Source materials updated September 29, 2026</span>
    </footer>
    {showHelpAction && (
      <aside class="help-action" aria-label="Help request answers about Ukraine TPS">
        <div class="shell help-action-inner">
          <p>Help ask for clear answers about Ukraine TPS.</p>
          <a class="button" href="/take-action/">How can I help?</a>
        </div>
      </aside>
    )}
  </body>
</html>
