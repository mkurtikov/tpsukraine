---
import Layout from '../layouts/Layout.astro';
import { Content, getHeadings } from '../content/background.md';
const headings = getHeadings().filter(heading => heading.depth === 2);
---
<Layout title="Ukraine TPS background — Ukraine TPS Collective" description="The background, timeline, laws, and four questions behind the community inquiry about Ukraine TPS after October 19, 2026." page="background">
  <div class="shell">
    <header class="article-header">
      <p class="breadcrumb"><a href="/">Overview</a><span aria-hidden="true">/</span>TPS background</p>
      <p class="eyebrow">The full background</p>
      <h1>Ukraine TPS and the answers we’re asking Congress to obtain.</h1>
      <p class="article-deck">The context, the relevant laws, and the practical questions that need a clear official response.</p>
      <div class="reading-meta"><span>Updated September 29, 2026</span><span>For affected people, employers, and supporters</span></div>
    </header>
    <div class="article-layout">
      <aside class="article-sidebar" aria-label="On this page">
        <p class="eyebrow">In this briefing</p>
        <div class="contents-links">{headings.map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</div>
      </aside>
      <div>
        <details class="mobile-contents"><summary>In this briefing</summary><div class="contents-links">{headings.map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</div></details>
        <article class="prose"><Content /></article>
        <div class="article-end"><a class="text-link" href="/">Back to overview</a></div>
      </div>
    </div>
  </div>
</Layout>
